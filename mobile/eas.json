        "EXPO_PUBLIC_API_URL": "https://zero-ji-ka-hukum-api.onrender.com"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://zero-ji-ka-hukum-api.onrender.com"
      }
    }
  }
}
